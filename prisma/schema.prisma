// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
}

// Users model
model Users {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  password      String
  fullName      String?
  provider      AuthProvider?
  createdAt     DateTime        @default(now())
  Location      Locations[]
  Collections   Collections[]
  RefreshTokens RefreshTokens[]
  ActivityLogs  ActivityLogs[]
}

// Locations model
model Locations {
  id              Int               @id @default(autoincrement())
  user            Users             @relation(fields: [userId], references: [id])
  userId          Int
  title           String
  description     String?
  latitude        Float
  longitude       Float
  address         String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LocationTags    LocationTags[]
  category        Categories?       @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  CollectionItems CollectionItems[]

  @@index([userId])
  @@index([latitude, longitude])
}

// Category model
model Categories {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  Locations Locations[]
}

// Tags model
model Tags {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  LocationTags LocationTags[]
}

// Location Tags model
model LocationTags {
  tag        Tags      @relation(fields: [tagId], references: [id])
  tagId      Int
  location   Locations @relation(fields: [locationId], references: [id])
  locationId Int

  @@id([locationId, tagId])
}

// Collections model
model Collections {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  user            Users             @relation(fields: [userId], references: [id])
  userId          Int
  description     String
  isPublic        Boolean           @default(false)
  CollectionItems CollectionItems[]

  @@unique([userId, name])
}

// Collection items model
model CollectionItems {
  collection   Collections @relation(fields: [collectionId], references: [id])
  collectionId Int
  location     Locations   @relation(fields: [locationId], references: [id])
  locationId   Int

  @@id([collectionId, locationId])
}

// Refresh Tokens model
model RefreshTokens {
  id        Int      @id @default(autoincrement())
  user      Users    @relation(fields: [userId], references: [id])
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Activity Logs model
model ActivityLogs {
  id        Int      @id @default(autoincrement())
  user      Users    @relation(fields: [userId], references: [id])
  userId    Int
  action    String
  metadata  Json
  createdAt DateTime @default(now())
}
